{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/llm.js": {
      "maxDuration": 120
    },
    "api/fetch-price.js": {
      "maxDuration": 120
    },
    "api/invite.js": {
      "maxDuration": 30
    },
    "api/send-estimate-email.js": {
      "maxDuration": 30
    },
    "api/recurring-projects.js": {
      "maxDuration": 30
    },
    "api/document-pdf.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/recurring-projects",
      "schedule": "0 0 1 * *"
    }
  ]
}\n