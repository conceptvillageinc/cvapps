{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/llm.js": {
      "maxDuration": 120
    },
    "api/fetch-price.js": {
      "maxDuration": 120
    },
    "api/invite.js": {
      "maxDuration": 30
    },
    "api/send-estimate-email.js": {
      "maxDuration": 30
    },
    "api/recurring-projects.js": {
      "maxDuration": 30
    },
    "api/document-pdf.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/send-document-email.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/export-schedule-sheet.js": {
      "maxDuration": 30
    },
    "api/read-sheet.js": {
      "maxDuration": 30
    },
    "api/capture-url.js": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/check-email-replies.js": {
      "maxDuration": 30
    },
    "api/meeting-process.js": {
      "maxDuration": 300
    },
    "api/meetings-cleanup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/recurring-projects",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/meetings-cleanup",
      "schedule": "0 18 * * *"
    }
  ]
}
