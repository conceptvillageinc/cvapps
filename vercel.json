{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/llm.js": {
      "maxDuration": 120
    },
    "api/fetch-price.js": {
      "maxDuration": 120
    },
    "api/invite.js": {
      "maxDuration": 30
    }
  }
}
