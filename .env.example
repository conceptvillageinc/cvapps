# このファイルを .env.local にコピーして値を設定してください。
# .env.local は .gitignore 済みです（コミットされません）。

# Supabase プロジェクトURL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase publishable key（旧 anon key）
# ブラウザに載る前提の公開鍵です。アクセス制御は Postgres 側の RLS が担います。
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# 【重要】service_role key は絶対にここへ書かないでください。
# あれは RLS を無視できる管理者権限の鍵です。
# サーバー側（Vercel Functions）でのみ使い、Vercel の環境変数に直接設定します。
# VITE_ 接頭辞をつけるとブラウザのJSに埋め込まれてしまうため、
# サーバー用の値には VITE_ をつけないこと。
# ----------------------------------------------------------------------------
